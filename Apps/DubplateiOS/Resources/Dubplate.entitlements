<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Deliberately empty. An iPhone needs no entitlement to hold a library, play it
    back or take over the Lock Screen; it needs them only to sync, and a free Apple
    Developer account cannot sign an application that asks for iCloud or Push
    Notifications at all.

    To turn sync on, with a paid account, see "Turning on iCloud sync" in
    Documentation/SYNC.md.
-->
<plist version="1.0">
<dict/>
</plist>
